{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/__autopatch/:path*", "destination": "/api/index?__ap_path=/__autopatch/:path*" },
    { "source": "/api/v1/:path*", "destination": "/api/index?__ap_path=/api/v1/:path*" },
    { "source": "/api/v2/:path*", "destination": "/api/index?__ap_path=/api/v2/:path*" },
    { "source": "/console", "destination": "/console.html" },
    { "source": "/console/", "destination": "/console.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/demo/", "destination": "/demo.html" }
  ]
}
